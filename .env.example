# Copy to .env for LOCAL secrets (git-ignored), OR set these in the RunPod
# pod/template "Environment Variables" (recommended for deploys — see README).
# The pipeline reads them from the shell, then .env, then the container boot env (PID 1),
# so anything set in the RunPod template is picked up automatically.

# Hugging Face token — required to download GATED models (CometKiwi QE).
# Accept the model license on huggingface.co first, then set the token.
HF_TOKEN=

# Optional: GitHub token for pushing from the pod (or set in the RunPod template).
# GITHUB_TOKEN=

# Optional overrides:
# HF_HOME=/workspace/hf-cache
